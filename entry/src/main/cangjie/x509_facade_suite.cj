// ---------------------------------------------------------------------------
// Test: fromPem parses known fields
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Test class: x509 core facade
// ---------------------------------------------------------------------------

@Test
class X509CoreCertUT {
    // Test: fromPem parses known fields
    @TestCase
    func testFromPemFields() {
        let certs = Cert.fromPem(LEAF_PEM)
        @Expect(certs.size, 1)
        let leaf = certs[0]

        // Serial number
        @Expect(leaf.serialNumber, "E01B5308B74E3EF9")

        // Signature algorithm contains "ecdsa-with-SHA1"
        let sigAlg = leaf.signatureAlgorithm
        @Expect(sigAlg.contains("ecdsa-with-SHA1"), true)

        // Subject contains "Test Leaf"
        let subj = leaf.subject
        @Expect(subj.contains("Test Leaf"), true)

        // Issuer contains "Test Intermediate"
        let iss = leaf.issuer
        @Expect(iss.contains("Intermediate"), true)
    }

    // Test: fromDer round-trip via fromPem
    @TestCase
    func testFromDerRoundTrip() {
        let certs = Cert.fromPem(LEAF_PEM)
        @Expect(certs.size, 1)
        let leaf = certs[0]
        let derBytes = leaf.toDer()
        let cert2 = Cert.fromDer(derBytes)
        @Expect(cert2.serialNumber, leaf.serialNumber)
        @Expect(cert2.subject, leaf.subject)
    }

    // Test: verifyChain positive — leaf <- int <- root
    @TestCase
    func testVerifyChainPositive() {
        let root = Cert.fromPem(ROOT_CA_PEM)[0]
        let int0 = Cert.fromPem(INT_CA_PEM)[0]
        let leaf = Cert.fromPem(LEAF_PEM)[0]
        let result = verifyChain(leaf, [int0], [root])
        @Expect(result, true)
    }

    // Test: verifyChain negative — wrong root
    @TestCase
    func testVerifyChainWrongRoot() {
        let wrongRoot = Cert.fromPem(WRONG_CA_PEM)[0]
        let int0 = Cert.fromPem(INT_CA_PEM)[0]
        let leaf = Cert.fromPem(LEAF_PEM)[0]
        let result = verifyChain(leaf, [int0], [wrongRoot])
        @Expect(result, false)
    }

    // Test: verifyChain negative — expired date window
    @TestCase
    func testVerifyChainExpiredDate() {
        let root = Cert.fromPem(ROOT_CA_PEM)[0]
        let int0 = Cert.fromPem(INT_CA_PEM)[0]
        let leaf = Cert.fromPem(LEAF_PEM)[0]
        // Leaf notAfter is 2027-06-12; verify at 2030-01-01 which is past expiry
        let futureDate = DateTime.of(year: 2030, month: 1, dayOfMonth: 1)
        let result = verifyChain(leaf, [int0], [root], date: Some(futureDate))

        @Expect(result, false)
    }

    // Test: getPublicKeyX963 known vector
    @TestCase
    func testGetPublicKeyX963() {
        let leaf = Cert.fromPem(LEAF_PEM)[0]
        let x963 = getPublicKeyX963(leaf)
        @Expect(x963.size, 65)
        @Expect(x963[0], 0x04u8)
        @Expect(x963 == LEAF_X963, true)
    }

    // Test: getPublicKeyX963 starts with 0x04 for all test certs
    @TestCase
    func testPublicKeyX963FormatAll() {
        for (pem in [ROOT_CA_PEM, INT_CA_PEM, LEAF_PEM]) {
            let cert = Cert.fromPem(pem)[0]
            let x963 = getPublicKeyX963(cert)
            @Expect(x963.size, 65)
            @Expect(x963[0], 0x04u8)
        }
    }
}
